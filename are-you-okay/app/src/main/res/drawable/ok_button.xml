<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape><corners android:radius="@dimen/radius_large" /><solid android:color="@color/ok_green_pressed" /></shape>
            </item>
            <item>
                <shape><corners android:radius="@dimen/radius_large" /><solid android:color="@color/ok_green" /></shape>
            </item>
        </selector>
    </item>
</ripple>
