<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: words on the left, the big button on the right. Same view IDs as portrait. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/screen_padding">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/date"
                        style="@style/Text.Overline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/settings_button"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/button_icon"
                        android:contentDescription="@string/settings"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/greeting"
                    style="@style/Text.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityHeading="true" />

                <TextView
                    android:id="@+id/prompt"
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <LinearLayout
                    android:id="@+id/status_card"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:id="@+id/status_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/status_text"
                        style="@style/Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/ok_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:background="@drawable/ok_button"
            android:stateListAnimator="@animator/press_scale"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="180dp"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ok_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_heart"
                android:tint="@color/on_ok_green" />

            <!-- Shrinks to fit on small phones with very large text instead of being cut off. -->
            <TextView
                android:id="@+id/ok_label"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:autoSizeMaxTextSize="56sp"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeTextType="uniform"
                android:maxLines="1"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="@string/im_ok"
                android:textColor="@color/on_ok_green"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ok_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/on_done_container"
                android:textSize="20sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
