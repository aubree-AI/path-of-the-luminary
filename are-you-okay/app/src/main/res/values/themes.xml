<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AreYouOkay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/ok_green</item>
        <item name="android:colorPrimaryDark">@color/background</item>
        <item name="android:colorAccent">@color/ok_green</item>
        <item name="android:colorControlActivated">@color/ok_green</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <!-- Text styles. Sizes are in sp so they follow the phone's font-size setting. -->
    <style name="Text" />
    <style name="Text.Display">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="Text.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="Text.Secondary">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="Text.Overline">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Settings building blocks. -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
    </style>
    <style name="CardTitle" parent="Text.Title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="CardHelp" parent="Text.Secondary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>
    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/field</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_ok_green</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">20dp</item>
    </style>
    <style name="SecondaryButton" parent="PrimaryButton">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/ok_green</item>
    </style>
    <style name="Chip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/chip</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:paddingHorizontal">8dp</item>
    </style>
</resources>
